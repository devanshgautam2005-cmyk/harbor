<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Dark, not Light.

      Compose paints almost everything, but not quite everything: the parent
      theme still decides the text-selection handles, the cursor, the magnifier
      and any platform dialog. Left on Light those all arrive tuned for a white
      page, and the selection handles in particular are nearly invisible on the
      dusk ground -- which only shows up when somebody edits a name or a note,
      long after the screens themselves look finished.
    -->
    <style name="Theme.Harbor" parent="android:Theme.Material.NoActionBar">
        <!-- What the window is before the first frame. See colors.xml. -->
        <item name="android:windowBackground">@color/harbor_ground</item>
    </style>
</resources>
