<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The ground, matching Paper in ui/theme/Color.kt.

      This exists so the window has Harbor's colour before Compose draws a
      single pixel. Without it the app opens on the platform's white and then
      snaps to the ground colour. If Paper changes, change it here too; there
      is no way to share a value between Kotlin and a resource file.

      It matters more on the dark skin than it did on the light one: a bone
      ground flashing before a bone app was invisible, but white flashing
      before a near-black app is the most obvious defect in the whole build.
    -->
    <color name="harbor_ground">#0D0E11</color>

    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
